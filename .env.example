# Database - PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/finance_companion

# JWT Secret - generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# OpenRouter API Key (optional - for AI insights)
finance_companion_key=your-openrouter-api-key

# Whisper Model (optional - default: small)
# Options: tiny, base, small, medium, large
WHISPER_MODEL=small

# Frontend URL for CORS (set in production)
FRONTEND_URL=http://localhost:5173
