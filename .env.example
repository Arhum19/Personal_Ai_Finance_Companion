# Finance Companion Environment Variables
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to git (it's in .gitignore)

# OpenRouter API Key
# Get your key from https://openrouter.ai/
# 1. Sign up at https://openrouter.ai/
# 2. Go to Account > API Keys
# 3. Create a new API key
# 4. Paste it here
OPENROUTER_API_KEY=sk-or-v1-YOUR_NEW_KEY_HERE

# Database Connection (if needed for custom setup)
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_companion

# Optional: Whisper Model Size
# WHISPER_MODEL=base (other options: tiny, small, medium, large)
